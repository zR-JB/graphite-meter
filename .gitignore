# --- Client (Svelte/Vite, bun) ---
client/node_modules
client/dist
client/.e2e-dist
client/.vite
client/.svelte-check
client/test-results
# raw benchmark rows; findings live in docs/BENCHMARKS.md, rows are not committed
client/bench/results/

# --- Go module (server + native client) ---
go/graphite-meter
go/graphite-meter-client
# test/coverage artifacts mise tasks and `go test -c` emit
go/cover.out
.go-cache/
*.test
# release cross-compile intermediates + archives; must stay ignored so
# buildvcs stamps vcs.modified=false and release binaries reproduce
# bit-for-bit from a clean checkout of the tag
go/graphite-meter-client.exe
go/dist/
# embedded client build injected at Docker/build time (not committed);
# keep the placeholder so //go:embed + go build/test work without a client build.
go/internal/static/dist/*
!go/internal/static/dist/.gitkeep

# --- General ---
.tools/
# (no bare `dist` rule — it would shadow the Go embed placeholder negation
#  above; dist dirs are ignored explicitly per-package.)
node_modules
.DS_Store
*.local
.vite

# Python bytecode and cache
*.pyc
__pycache__

# Claude Code — personal, machine-local settings
.claude/settings.local.json

# Local TLS material must stay outside Git. Certificates are public, but
# committing them encourages committing the matching private key later.
.dev-certs/
certs/
certificates/
letsencrypt/
*.pem
*.key
*.crt
*.cer
*.der
*.csr
*.p12
*.pfx
*.pkcs8
*.jks
*.keystore

# Populated Tailscale-sidecar Quadlet environment files may contain auth keys.
container/quadlet/tailscale-sidecar/*.env
