# --- Client (Svelte/Vite, bun) ---
client/node_modules
client/dist
client/.vite

# --- Go module (server + native client) ---
go/graphite-meter
go/graphite-meter-client
# release cross-compile intermediates + archives; must stay ignored so
# buildvcs stamps vcs.modified=false and release binaries reproduce
# bit-for-bit from a clean checkout of the tag
go/graphite-meter-client.exe
go/dist/
# embedded client build injected at Docker/build time (not committed);
# keep the placeholder so //go:embed + go build/test work without a client build.
go/internal/static/dist/*
!go/internal/static/dist/.gitkeep

# --- General ---
# (no bare `dist` rule — it would shadow the Go embed placeholder negation
#  above; dist dirs are ignored explicitly per-package.)
node_modules
.DS_Store
*.local
.vite

# Local planning artifact (mirror of ~/.claude/plans, not part of the repo)
the-next-step-will-harmonic-harp.md

# Claude Code — personal, machine-local settings (shared settings.json is tracked)
.claude/settings.local.json
