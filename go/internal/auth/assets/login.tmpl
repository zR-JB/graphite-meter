<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="data:image/svg+xml;base64,">
    <title>Graphite Meter — Sign in</title>
    {{template "theme"}}
    <style>{{.Styles}}</style>
  </head>
  <body>
    <main class="card">
      <p class="brand"><svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><path class="hex" d="M12 2.6 3.9 7.3v9.4l8.1 4.7 8.1-4.7V7.3Z" fill="none" stroke-width="2"/><path d="M12 12 18.6 8.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="2.1" fill="currentColor"/></svg>Graphite Meter</p>
      <h1>Sign in</h1>
      <p>This measurement server is private.</p>
      {{if eq .Status "signed_out"}}<p class="notice" role="status">You're signed out.</p>{{end}}
      {{if eq .Status "expired"}}<p class="notice" role="status">Your session ended. Sign in again.</p>{{end}}
      {{if eq .Status "renew"}}<p class="notice" role="status">Sign in again before starting this long test.</p>{{end}}
      {{if eq .Notice "password"}}
        <p class="notice" data-tone="err" role="alert">Incorrect password. Check it and try again.</p>
      {{else if eq .Notice "throttled"}}
        <p class="notice" data-tone="warn" role="alert">Too many attempts. Wait a minute and try again.</p>
      {{else if eq .Notice "provider"}}
        <p class="notice" data-tone="warn" role="alert">{{.Provider}} is unavailable right now.{{if .Password}} Sign in with the operator password.{{end}}</p>
      {{else if eq .Notice "busy"}}
        <p class="notice" data-tone="warn" role="alert">The server is busy. Try again in a moment.</p>
      {{else if eq .Notice "stale"}}
        <p class="notice" data-tone="warn" role="alert">This sign-in form expired. Try again.</p>
      {{else if .Notice}}
        <p class="notice" data-tone="err" role="alert">Sign-in failed. Try again.</p>
      {{end}}
      {{if .OIDC}}
        <form method="post" action="/auth/oidc/start">
          <input type="hidden" name="csrf" value="{{.CSRF}}">
          <input type="hidden" name="challenge" value="{{.Challenge}}">
          <button type="submit" {{if not .OIDCReady}}disabled{{end}}>Continue with {{.Provider}}</button>
        </form>
        {{if and (not .OIDCReady) (ne .Notice "provider")}}<p class="notice">{{.Provider}} is unavailable right now.</p>{{end}}
      {{end}}
      {{if and .OIDC .Password}}<div class="separator">or</div>{{end}}
      {{if .Password}}
        <form method="post" action="/auth/password">
          <input type="hidden" name="csrf" value="{{.CSRF}}">
          <input type="hidden" name="challenge" value="{{.Challenge}}">
          <!-- There is one account. The field exists so a password manager can
               associate the stored credential with a username; it is not read
               by the server. -->
          <label class="sr-only" for="username">Account</label>
          <input class="sr-only" id="username" name="username" type="text" value="operator" autocomplete="username" readonly tabindex="-1">
          <!-- Beside a working provider the caret stays out of the operator's field. -->
          <div class="field">
            <label for="password">Operator password</label>
            <input id="password" name="password" type="password" maxlength="1024" autocomplete="current-password" {{if not (and .OIDC .OIDCReady)}}autofocus{{end}} required>
          </div>
          <button type="submit">Sign in</button>
        </form>
      {{end}}
    </main>
    {{template "pending"}}
  </body>
</html>
