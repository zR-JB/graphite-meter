{"page":"login","csrf":"csrf-token","password":true}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="data:image/svg+xml;base64,">
    <title>Graphite Meter — Sign in</title>
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d1013"><meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0f3f6"><script>/* theme.js */</script>
    <style>/* auth.css */</style>
  </head>
  <body>
    <main class="card">
      <p class="brand"><svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><path class="hex" d="M12 2.6 3.9 7.3v9.4l8.1 4.7 8.1-4.7V7.3Z" fill="none" stroke-width="2"/><path d="M12 12 18.6 8.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="2.1" fill="currentColor"/></svg>Graphite Meter</p>
      <h1>Sign in</h1>
      <p>This measurement server is private.</p>
      
      
      
      
      
      
      
        <form method="post" action="/auth/password">
          <input type="hidden" name="csrf" value="csrf-token">
          <input type="hidden" name="challenge" value="">
          
          <label class="sr-only" for="username">Account</label>
          <input class="sr-only" id="username" name="username" type="text" value="operator" autocomplete="username" readonly tabindex="-1">
          
          <div class="field">
            <label for="password">Operator password</label>
            <input id="password" name="password" type="password" maxlength="1024" autocomplete="current-password" autofocus required>
          </div>
          <button type="submit">Sign in</button>
        </form>
      
    </main>
    <script>/* pending.js */</script>
  </body>
</html>
