+    #[test]
+    fn the_reno_friendly_estimate_restarts_at_the_reduced_window() {
+        let now = Instant::now();
+        let rtt = RttEstimator::new(Duration::from_millis(100));
+        let mut cubic = Cubic::new(
+            Arc::new(CubicConfig::default()),
+            now,
+            BASE_DATAGRAM_SIZE as u16,
+        );
+        let window = 20 * BASE_DATAGRAM_SIZE;
+        cubic.state.window = window;
+        cubic.state.ssthresh = window;
+        // Below the last W_max, so fast convergence lowers W_max to 0.85 of the window.
+        cubic.state.w_max = 30.0 * BASE_DATAGRAM_SIZE as f64;
+
+        cubic.on_congestion_event(now, now, false, false, 0, 0);
+        let reduced = cubic.state.window;
+        assert_eq!(cubic.state.w_est, reduced as f64);
+        // RFC 8312's estimate began at beta_cubic * W_max, below the window CUBIC had just cut to.
+        assert!(BETA_CUBIC * cubic.state.w_max < reduced as f64);
+
+        // A window of packets sent after the event, acknowledged: W_est gains about alpha_cubic
+        // segments.
+        let later = now + Duration::from_millis(50);
+        for _ in 0..reduced / BASE_DATAGRAM_SIZE {
+            cubic.on_ack(later, later, BASE_DATAGRAM_SIZE, 0, false, &rtt);
+        }
+        let gained = (cubic.state.w_est - reduced as f64) / BASE_DATAGRAM_SIZE as f64;
+        assert!((gained - ALPHA_CUBIC).abs() < 0.05, "{gained}");
+    }
