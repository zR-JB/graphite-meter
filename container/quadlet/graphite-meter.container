# Quadlet .container unit - the default deployment. Pulls the published
# release image; nothing is built locally. Versions (server binary + web
# client) are stamped into the image at release time, so there is only runtime
# config here. Install: see ./README.md.
#
# To build from source instead, use graphite-meter-source.container +
# graphite-meter.build.
#
# Docs: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description=Graphite Meter speed-test server

[Container]
ContainerName=graphite-meter
# Pin a release for reproducible deploys, e.g. ...:0.6.0 or ...:0.6
Image=ghcr.io/zr-jb/graphite-meter:latest
# Pull new releases automatically via podman-auto-update.timer (only sensible
# together with the :latest tag above):
# AutoUpdate=registry

# Clear HTTP/1.1 default; enable only the TLS targets you need.
PublishPort=7246:7246
# Dedicated HTTPS HTTP/1.1 throughput + WSS latency:
# PublishPort=7247:7247/tcp
# HTTP/2 only:
# PublishPort=7248:7248/tcp
# HTTP/3 bootstrap probe only (TCP) and throughput (UDP):
# PublishPort=7249:7249/tcp
# PublishPort=7249:7249/udp

# On rootless Podman, user-mode networking can use pasta and
# significantly reduce throughput. For better performance, uncomment:
# Network=host

# All optional; sensible defaults are baked in. Set the PUBLIC_* origins when
# running behind a reverse proxy so /preflight advertises reachable URLs.
Environment=GM_SERVER_NAME=graphite-meter
# Environment=GM_SERVER_LOCATION=fra
# Environment=GM_H1_ADDR=:7246
# Environment=GM_H1_TLS_ADDR=:7247
# Environment=GM_H2_ADDR=:7248
# Environment=GM_H3_ADDR=:7249
# Environment=GM_TLS_CERT=/etc/letsencrypt/live/graphite-meter/fullchain.pem
# Environment=GM_TLS_KEY=/etc/letsencrypt/live/graphite-meter/privkey.pem
# Volume=/etc/letsencrypt:/etc/letsencrypt:ro
# Environment=GM_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Environment=GM_H1_PUBLIC_ORIGIN=http://speed.example:7246
# Environment=GM_H1_TLS_PUBLIC_ORIGIN=https://speed.example:7247
# Environment=GM_H2_PUBLIC_ORIGIN=https://speed.example:7248
# Environment=GM_H3_PUBLIC_ORIGIN=https://speed.example:7249
# Environment=GM_VERBOSE=1

# Authentication, off by default. When enabled it gates every UI asset,
# discovery request, probe, transfer, progress stream, and WebSocket. The lines
# below assume a reverse proxy owns TLS on GM_AUTH_PUBLIC_URL: clear HTTP/1.1
# must not be advertised, and every advertised origin must be HTTPS on that
# hostname.
# Setup and the podman secret commands: ./README.md#enable-authentication
# Environment=GM_AUTH_MODE=password
# Environment=GM_AUTH_PUBLIC_URL=https://meter.example.com
# Environment=GM_ADVERTISED_NATIVE_ENDPOINTS=none
# Environment=GM_PUBLIC_ORIGINS=self
# Environment=GM_TRUSTED_PROXIES=172.30.0.0/24
# Environment=GM_AUTH_PASSWORD_HASH_FILE=/run/secrets/gm-auth-password-hash
# Secret=gm-auth-password-hash,type=mount
#
# OIDC instead of the password, or GM_AUTH_MODE=hybrid to keep both. The group
# allowlist is required whenever OIDC is enabled.
# Environment=GM_AUTH_MODE=oidc
# Environment=GM_AUTH_OIDC_ISSUER=https://auth.example.com
# Environment=GM_AUTH_OIDC_CLIENT_ID=graphite-meter
# Environment=GM_AUTH_OIDC_CLIENT_SECRET_FILE=/run/secrets/gm-auth-oidc-client-secret
# Environment=GM_AUTH_OIDC_ALLOWED_GROUPS=meter-users
# Environment=GM_AUTH_OIDC_PROVIDER_NAME=Authelia
# Secret=gm-auth-oidc-client-secret,type=mount

[Service]
# docker-compose's `restart: unless-stopped` - systemd's closest is always.
Restart=always
RestartSec=5

[Install]
# Start at boot (`systemctl --user enable` / linger for rootless).
WantedBy=multi-user.target default.target
