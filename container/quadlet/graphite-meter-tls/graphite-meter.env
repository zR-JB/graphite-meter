# Replace the hostname and email before starting the units.
# GM_PUBLIC_HOST, GM_CERT_NAME, and CERTBOT_EMAIL are read by the certbot units
# and by verify-cert.sh; the server ignores them.
GM_PUBLIC_HOST=meter.example.com
GM_CERT_NAME=graphite-meter
CERTBOT_EMAIL=admin@example.com

# Graphite Meter identity.
GM_SERVER_NAME=graphite-meter
# GM_SERVER_LOCATION=fra
GM_VERBOSE=0

# Native listeners. A non-empty address enables the listener; there are no
# separate enable switches. Host networking exposes them directly on the host.
GM_H1_ADDR=:7246
GM_H1_TLS_ADDR=:7247
GM_H2_ADDR=:7248
GM_H3_ADDR=:7249

# The certificate paths embed GM_CERT_NAME and the public origins embed
# GM_PUBLIC_HOST. Change all of them together.
GM_TLS_CERT=/etc/letsencrypt/live/graphite-meter/fullchain.pem
GM_TLS_KEY=/etc/letsencrypt/live/graphite-meter/privkey.pem
GM_H1_TLS_PUBLIC_ORIGIN=https://meter.example.com:7247
GM_H2_PUBLIC_ORIGIN=https://meter.example.com:7248
GM_H3_PUBLIC_ORIGIN=https://meter.example.com:7249
