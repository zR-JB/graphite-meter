# Keep the populated copy outside source control and mode 0600.
TS_AUTHKEY=
TS_HOSTNAME=graphite-meter
TS_CERT_DOMAIN=graphite-meter.example-tailnet.ts.net
TS_STATE_DIR=/var/lib/tailscale
TS_USERSPACE=false
TS_AUTH_ONCE=true
TS_ACCEPT_DNS=false
TS_NO_LOGS_NO_SUPPORT=true
TS_EXTRA_ARGS=--advertise-tags=tag:container
