# Replace the example MagicDNS name with the TS_CERT_DOMAIN configured for the
# sidecar. Keep bind addresses separate from client-facing public origins.
GM_H1_TLS_ADDR=:7247
GM_H2_ADDR=:7248
GM_H3_ADDR=:7249
GM_H1_ADDR=:80
GM_H1_TLS_ADDR=:443
GM_H2_ADDR=:8443
GM_H3_ADDR=:8444
GM_TLS_CERT=/certs/tls.crt
GM_TLS_KEY=/certs/tls.key
GM_H1_PUBLIC_ORIGIN=http://graphite-meter.example-tailnet.ts.net
GM_H1_TLS_PUBLIC_ORIGIN=https://graphite-meter.example-tailnet.ts.net
GM_H2_PUBLIC_ORIGIN=https://graphite-meter.example-tailnet.ts.net:8443
GM_H3_PUBLIC_ORIGIN=https://graphite-meter.example-tailnet.ts.net:8444
