# Replace the example MagicDNS name with the TS_CERT_DOMAIN configured for the
# sidecar. Keep bind addresses separate from client-facing public origins.
GM_ENABLE_H1_TLS=true
GM_ENABLE_H2=true
GM_ENABLE_H3=true
GM_H1_ADDR=:80
GM_H1_TLS_ADDR=:443
GM_H2_ADDR=:8443
GM_H3_ADDR=:8444
GM_TLS_CERT=/certs/tls.crt
GM_TLS_KEY=/certs/tls.key
PUBLIC_H1_ORIGIN=http://graphite-meter.example-tailnet.ts.net
PUBLIC_H1_TLS_ORIGIN=https://graphite-meter.example-tailnet.ts.net
PUBLIC_H2_ORIGIN=https://graphite-meter.example-tailnet.ts.net:8443
PUBLIC_H3_ORIGIN=https://graphite-meter.example-tailnet.ts.net:8444
