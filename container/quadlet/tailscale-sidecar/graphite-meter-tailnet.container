# No PublishPort and no host network: ingress belongs to the Tailscale sidecar.

[Unit]
Description=Graphite Meter on an isolated Tailscale network
BindsTo=graphite-meter-tailnet-tailscale.container
PartOf=graphite-meter-tailnet-tailscale.container
After=graphite-meter-tailnet-tailscale.container
StartLimitIntervalSec=0

[Container]
ContainerName=graphite-meter-tailnet
Image=ghcr.io/zr-jb/graphite-meter:latest
AutoUpdate=registry
Network=graphite-meter-tailnet-tailscale.container
EnvironmentFile=./graphite-meter-tailnet.env
Volume=graphite-meter-tailnet-certs.volume:/certs:ro
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE

[Service]
Restart=always
RestartSec=2
TimeoutStartSec=5min

[Install]
WantedBy=default.target
