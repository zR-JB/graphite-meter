# Quadlet .container unit — build-from-source variant (developers / custom
# builds, e.g. with the dummy engine or dev tools compiled in). The image is
# produced by the sibling graphite-meter.build unit (Image=*.build → builds
# first, then runs). For a normal deployment use graphite-meter.container,
# which pulls the published image instead. Install: see ./README.md.
#
# Docs: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description=Graphite Meter speed-test server (built from source)

[Container]
ContainerName=graphite-meter
# Reference the .build unit by filename — Quadlet builds it on demand and adds a
# dependency on graphite-meter-build.service.
Image=graphite-meter.build

# HTTP/1.1 (default). TLS + HTTP/3 (WebTransport) land in a later stage.
PublishPort=8765:8765
# PublishPort=8443:8443/tcp
# PublishPort=8443:8443/udp

# On rootless Podman, user-mode networking can use pasta and
# significantly reduce throughput. For better performance, uncomment:
# Network=host

# All optional; sensible defaults are baked in. Set the PUBLIC_* origins when
# running behind a reverse proxy so /preflight advertises reachable URLs.
Environment=GM_SERVER_NAME=graphite-meter
# Environment=GM_SERVER_LOCATION=fra
# Environment=GM_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Environment=PUBLIC_H1_ORIGIN=http://speed.example:8765
# Environment=GM_ADVERTISE_H3=0
# Environment=GM_VERBOSE=1

[Service]
# docker-compose's `restart: unless-stopped` — systemd's closest is always.
Restart=always
RestartSec=5

[Install]
# Start at boot (`systemctl --user enable` / linger for rootless).
WantedBy=multi-user.target default.target
