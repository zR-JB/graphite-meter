# Quadlet .build unit - builds the Graphite Meter production image.
# Referenced by graphite-meter.container via `Image=graphite-meter.build`, so
# the build runs automatically (as graphite-meter-build.service) before the
# container starts. Install: see ./README.md.
#
# Docs: https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html

[Unit]
Description=Build the Graphite Meter production image (arm64)

[Build]
ImageTag=localhost/graphite-meter:latest

# Containerfile + build context. The Dockerfile COPYs client/, go/ and api/,
# so the context (SetWorkingDirectory) MUST be the repo root, and File= is
# resolved relative to it.
#   ▸ Set SetWorkingDirectory to the ABSOLUTE path of your checkout on this host
#     (quadlet units live in a systemd search dir, not in the repo - see README).
SetWorkingDirectory=/path/to/graphite-meter
File=container/Dockerfile

# Build natively for arm64 (e.g. on a Raspberry Pi). Drop or change for amd64.
Arch=arm64

# The Dockerfile defaults already produce a real-only prod image. Uncomment to
# override the client build knobs or stamp a release version (equivalent to
# --build-arg). VERSION stamps the server binary; CLIENT_VERSION stamps the
# client release version. The source build keeps CLIENT_VERSION empty and uses
# GM_CLIENT_REVISION for its untagged identity.
# BuildArg=VERSION=0.6.0
# BuildArg=CLIENT_VERSION=0.6.0
# BuildArg=GM_CLIENT_REVISION=abc1234
# BuildArg=GM_CLIENT_ALLOW_DUMMY=1


PodmanArgs=--build-arg-file=%t/graphite-meter-build.args

[Service]
ExecStartPre=/bin/sh -c 'cd /path/to/graphite-meter && rev="$$(git rev-parse --short=7 HEAD)"; git diff --quiet || rev="$${rev}-dirty"; printf "VERSION=%%s\nCLIENT_VERSION=\nGM_CLIENT_REVISION=%%s\n" "$$rev" "$$rev" > %t/graphite-meter-build.args'
