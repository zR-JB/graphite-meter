<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- icon -->
    <meta http-equiv="refresh" content="0; url={{if .Challenge}}/auth/cli?challenge={{.Challenge}}{{else}}/{{end}}">
    <title>Graphite Meter — Signing in</title>
    {{template "theme"}}
    <style>{{.Styles}}</style>
  </head>
  <body>
    <main class="card completion">
      <!-- brand -->
      <h1>{{if .Opening}}Continue sign-in{{else}}Signed in{{end}}</h1>
      <p>Taking you to {{if .Challenge}}the approval page{{else}}Graphite&nbsp;Meter{{end}}…</p>
      <p><a href="{{if .Challenge}}/auth/cli?challenge={{.Challenge}}{{else}}/{{end}}">Continue</a></p>
    </main>
  </body>
</html>
