#!/bin/sh
# Scan staged content for secrets, then run the planned checks on exactly the staged tree.
set -eu

if git diff --cached --quiet; then
    exit 0
fi
if [ "$(git symbolic-ref --short -q HEAD)" = main ]; then
    echo "pre-commit: refusing to commit directly to main; create a branch first" >&2
    exit 1
fi
git diff --cached --check
mise exec -- gitleaks git --staged --redact --no-banner --verbose
checks=$(mise exec -- python3 scripts/ci/precommit.py)
if [ -z "$checks" ]; then
    exit 0
fi

root=$(git rev-parse --show-toplevel)
tree=$(git write-tree)
scratch=$(mktemp -d)
staged="$scratch/staged"
trap 'git -C "$root" worktree remove --force "$staged" 2>/dev/null || true; rm -rf "$scratch"' EXIT
trap 'exit 1' HUP INT TERM
git worktree add --quiet --detach --no-checkout "$staged" HEAD
# The hook's Git environment names the commit's index; the snapshot must use its own.
unset $(git rev-parse --local-env-vars)
cd "$staged"
git read-tree "$tree"
git checkout-index --all --force
export MISE_TRUSTED_CONFIG_PATHS="$staged"
(cd client && mise exec -- bun install --frozen-lockfile --prefer-offline)
for check in $checks; do
    mise run "$check"
done
