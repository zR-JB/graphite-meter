#!/bin/sh
# Mirrors the fast CI gates (ci.yml) on whatever is staged, plus local-only
# safety nets (secrets, conflict markers, accidental branch/large-file commits).
# The Docker smoke job remains CI-only because it is much heavier and needs a
# container runtime. Enable once per clone with:
# just hooks. Bypass a single commit with: git commit --no-verify
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo HEAD)
if [ "$branch" = "main" ]; then
    echo "pre-commit: refusing to commit directly to main — branch first (git checkout -b ...)"
    exit 1
fi

if git diff --cached -U0 --diff-filter=ACMR | grep -qE '^\+(<{7}|={7}|>{7})'; then
    echo "pre-commit: unresolved merge conflict markers in staged changes"
    exit 1
fi

tls_files=$(printf '%s\n' "$staged" | grep -Ei '(^|/)(\.dev-certs|certs?|certificates?|letsencrypt)(/|$)|\.(pem|key|crt|cer|der|csr|p12|pfx|pkcs8|jks|keystore)$' || true)
if [ -n "$tls_files" ]; then
    echo "pre-commit: refusing to commit TLS certificate or key material:"
    echo "$tls_files"
    exit 1
fi
if git diff --cached -U0 --diff-filter=ACMR | grep -qE '^\+-----BEGIN (CERTIFICATE|([^ -]+ )*PRIVATE KEY)-----'; then
    echo "pre-commit: refusing to commit PEM certificate or private-key material"
    exit 1
fi

max_kb=1024
big=""
for f in $staged; do
    kb=$(( $(git cat-file -s ":$f" 2>/dev/null || echo 0) / 1024 ))
    if [ "$kb" -gt "$max_kb" ]; then
        big="$big
$f (${kb}KB)"
    fi
done
if [ -n "$big" ]; then
    echo "pre-commit: staged file(s) over ${max_kb}KB — check this isn't a build artifact:$big"
    exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found — required for secret scanning."
    echo "  install (Fedora): sudo dnf install -y gitleaks"
    echo "  install (other):  go install github.com/gitleaks/gitleaks/v8@latest"
    exit 1
fi
echo "pre-commit: gitleaks (secret scan)"
gitleaks protect --staged --redact -v

# These call the same justfile recipes ci.yml runs, so the hook, `just ci`, and
# GitHub CI cannot describe different checks. The hook deliberately runs the
# fast subset: go-lint (staticcheck + govulncheck) and the Docker smoke job stay
# CI-only.
if echo "$staged" | grep -qE '^(go/|client/src/auth/)'; then
    echo "pre-commit: auth assets (just check-generated)"
    just check-generated
fi

if echo "$staged" | grep -q '^go/'; then
    echo "pre-commit: go (just server-check server-test)"
    just server-check
    just server-test
fi

if echo "$staged" | grep -q '^client/'; then
    echo "pre-commit: client (just client-ci)"
    just client-ci
fi

# Keep this path set aligned with the `legal` filter in ci.yml. Legal output
# depends on the source tree and packaging scripts, so those changes need the
# same four legal gates locally that CI runs.
if echo "$staged" | grep -qE '^(legal/|LICENSE$|COPYRIGHT$|go/|client/|container/|scripts/package-tui\.sh$|scripts/tui-package-test\.sh$|scripts/legal-source-bundle-test\.sh$|\.github/workflows/(ci|release)\.yml$|justfile$)'; then
    echo "pre-commit: legal (just legal-check tui-package-test tui-legal-test legal-source-bundle-test)"
    just legal-check
    just tui-package-test
    just tui-legal-test
    just legal-source-bundle-test
fi
