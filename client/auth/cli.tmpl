<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- icon -->
    <title>{{if .Refused}}Approval unavailable{{else if .BrowserCapacity}}Client limit reached{{else if .BrowserOrigin}}Approve browser client{{else}}Approve terminal client{{end}} · Graphite Meter</title>
    {{template "theme"}}
    <style>{{.Styles}}</style>
  </head>
  <body>
    <main class="card">
      <!-- brand -->
      {{if .Refused}}
      <!-- Each refusal kind gets one fixed sentence, so nothing from the request is echoed. -->
      <h1>Approval unavailable</h1>
      {{if eq .Refused "busy"}}
      <p>Too many approvals are open. Try again from the client in a few minutes.</p>
      {{else}}
      <p>This approval link is not valid. Start sign-in again from the client.</p>
      {{end}}
      {{else if .BrowserCapacity}}
      <h1>Client limit reached</h1>
      <p>This sign-in already has {{.ClientLimit}} approved clients, the most it can have.</p>
      <p>Renewing the sign-in ends their access and any tests they are running.</p>
      <p><a href="/login">Renew this sign-in</a>, then choose Sign in again on the site that asked.</p>
      {{else}}
      {{if .BrowserOrigin}}
      <h1>Approve browser client</h1>
      <p>Approve only a site you opened yourself. The site below can then run tests as you until you sign out or this sign-in expires.</p>
      <p class="origin"><strong>{{.BrowserOrigin}}</strong></p>
      <p>Confirm that this code matches the code on that site.</p>
      {{else}}
      <h1>Approve terminal client</h1>
      <p>Approve only a terminal you started yourself. It can then run tests as you until you sign out or this sign-in expires.</p>
      <p>Confirm that this code matches the code in your terminal.</p>
      {{end}}
      <code class="code">{{.Code}}</code>
      <form method="post" action="{{if .BrowserOrigin}}/auth/browser/approve{{else}}/auth/cli/approve{{end}}">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <input type="hidden" name="challenge" value="{{.Challenge}}">
        <button type="submit">Approve this client</button>
      </form>
      {{end}}
    </main>
    {{template "pending"}}
  </body>
</html>
