<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <!-- icon -->
    <title>Graphite Meter — Client approved</title>
    {{template "theme"}}
    <style>{{.Styles}}</style>
  </head>
  <body>
    <main class="card completion">
      <!-- brand -->
      {{if .Browser}}
      <h1>Browser client approved</h1>
      <p>The site you approved can now run measurements as you. You can close this tab and return to it.</p>
      {{else}}
      <h1>Terminal client approved</h1>
      <p>Your terminal can now run measurements as you. You can close this tab and return to it.</p>
      {{end}}
    </main>
  </body>
</html>
