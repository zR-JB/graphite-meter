{
  "name": "graphite-meter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && bun run build:bundle",
    "build:bundle": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.check.json --tsgo",
    "check:webview": "bun run scripts/check-webview.ts",
    "build:browser": "GM_CLIENT_ALLOW_DUMMY=1 GM_CLIENT_BUILD_PROFILE=dev GM_CLIENT_REVISION=browser-test VERSION= vite build",
    "test:browser": "bun run build:browser && bun test browser --parallel=3 --path-ignore-patterns=**/presentation-performance.test.ts --no-orphans --timeout 30000 && bun test ./browser/presentation-performance.test.ts --no-orphans --timeout 30000",
    "build:e2e-harness": "vite build -c vite.e2e.config.ts",
    "test:bench": "bun run build:e2e-harness && bun test ./bench/throughput.bench.ts --no-orphans --timeout 1800000",
    "test:e2e": "bun run build:e2e-harness && sh scripts/e2e.sh --no-orphans --timeout 60000",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "npm:bun-types@^1.4.2",
    "axe-core": "^4.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
