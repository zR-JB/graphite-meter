{
  "name": "graphite-meter-client",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "imports": {
    "#jsx/jsx-runtime": "./src/lib/jsx-runtime.ts",
    "#jsx/jsx-dev-runtime": "./src/lib/jsx-runtime.ts"
  },
  "devDependencies": {
    "@types/bun": "npm:bun-types@1.4.3",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.5"
  },
  "scripts": {
    "build:bundle": "bun build.ts",
    "build:auth": "bun auth/build.ts",
    "build": "bun run check && bun run build:bundle",
    "check": "bun check && bun test ./auth",
    "format": "biome format --write .",
    "format:check": "biome format . && bun auth/build.ts --check",
    "test:e2e": "bun test ./e2e --no-orphans --timeout=60000",
    "e2e": "bun run scripts/e2e.ts"
  }
}
