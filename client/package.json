{
  "name": "graphite-meter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && bun run build:bundle",
    "build:bundle": "vite build",
    "preview": "vite preview",
    "check": "bun run check:client && bun run check:node",
    "check:client": "svelte-check --tsconfig ./tsconfig.check.json",
    "check:node": "tsc --noEmit -p ./tsconfig.node.json",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/svelte": "^5.0.4",
    "@types/bun": "^1.3.14",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4"
  }
}
