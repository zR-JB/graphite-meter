<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Sign in · Graphite Meter</title>
    <style>{{.Styles}}</style>
  </head>
  <body>
    <main class="card">
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6 3.9 7.3v9.4l8.1 4.7 8.1-4.7V7.3Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 12 18.6 8.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="2.1" fill="currentColor"/></svg>
      <h1>Private Graphite Meter</h1>
      <p>Sign in to use this measurement server.</p>
      {{if .Expired}}<p class="message" role="alert">Your session expired. Sign in again.</p>{{end}}
      {{if .Error}}<p class="message" role="alert">Sign-in failed.</p>{{end}}
      {{if .OIDC}}
        <form method="post" action="/auth/oidc/start">
          <input type="hidden" name="csrf" value="{{.CSRF}}">
          <input type="hidden" name="challenge" value="{{.Challenge}}">
          <button type="submit" {{if not .OIDCReady}}disabled{{end}}>Continue with {{.Provider}}</button>
        </form>
        {{if not .OIDCReady}}<p class="neutral">{{.Provider}} is temporarily unavailable.</p>{{end}}
      {{end}}
      {{if and .OIDC .Password}}<div class="separator">or</div>{{end}}
      {{if .Password}}
        <form method="post" action="/auth/password">
          <input type="hidden" name="csrf" value="{{.CSRF}}">
          <input type="hidden" name="challenge" value="{{.Challenge}}">
          <label for="password">Operator password</label>
          <input id="password" name="password" type="password" maxlength="1024" autocomplete="current-password" required>
          <button type="submit">Sign in with operator password</button>
        </form>
      {{end}}
    </main>
  </body>
</html>
