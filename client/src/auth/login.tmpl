<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="data:image/svg+xml;base64,">
    <title>Sign in · Graphite Meter</title>
    {{template "theme"}}
    <style>{{.Styles}}</style>
  </head>
  <body>
    <main class="card">
      <svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><path class="hex" d="M12 2.6 3.9 7.3v9.4l8.1 4.7 8.1-4.7V7.3Z" fill="none" stroke-width="2"/><path d="M12 12 18.6 8.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="2.1" fill="currentColor"/></svg>
      <h1>Private Graphite Meter</h1>
      <p>Sign in to use this measurement server.</p>
      {{if .Expired}}<p class="message" role="alert">Your session expired. Sign in again.</p>{{end}}
      {{if eq .Notice "provider"}}
        <p class="message" role="alert">{{.Provider}} is unreachable right now.{{if .Password}} Sign in with the operator password.{{end}}</p>
      {{else if eq .Notice "busy"}}
        <p class="message" role="alert">The server is busy. Try again in a moment.</p>
      {{else if eq .Notice "stale"}}
        <p class="message" role="alert">This sign-in form expired. Try again.</p>
      {{else if .Notice}}
        <p class="message" role="alert">Sign-in failed.</p>
      {{end}}
      {{if .OIDC}}
        <form method="post" action="/auth/oidc/start">
          <input type="hidden" name="csrf" value="{{.CSRF}}">
          <input type="hidden" name="challenge" value="{{.Challenge}}">
          <button type="submit" {{if not .OIDCReady}}disabled{{end}}>Continue with {{.Provider}}</button>
        </form>
        {{if not .OIDCReady}}<p class="notice">{{.Provider}} is temporarily unavailable.</p>{{end}}
      {{end}}
      {{if and .OIDC .Password}}<div class="separator">or</div>{{end}}
      {{if .Password}}
        <form method="post" action="/auth/password">
          <input type="hidden" name="csrf" value="{{.CSRF}}">
          <input type="hidden" name="challenge" value="{{.Challenge}}">
          <!-- There is one account. The field exists so a password manager can
               associate the stored credential with a username; it is not read
               by the server. -->
          <label class="offscreen" for="username">Account</label>
          <input class="offscreen" id="username" name="username" type="text" value="operator" autocomplete="username" readonly>
          <label for="password">Operator password</label>
          <input id="password" name="password" type="password" maxlength="1024" autocomplete="current-password" required>
          <button type="submit">Sign in with operator password</button>
        </form>
      {{end}}
    </main>
    {{template "pending"}}
  </body>
</html>
