# The build context is the repository root (docker build -f container/Dockerfile .); keep it lean.
.git
.claude
**/node_modules
**/.DS_Store
**/__pycache__
client/dist
client/test-results
# The image's check covers what it builds, not the browser suite, its launcher or the benchmarks.
client/e2e
client/scripts
client/bench
rust/target
dist
# Image builds fetch and check the pinned platform notices themselves.
legal/manual/llvm
legal/manual/musl

# Never send local TLS material to the image builder.
**/.dev-certs
**/certs
**/certificates
**/letsencrypt
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.csr
**/*.p12
**/*.pfx
**/*.pkcs8
**/*.jks
**/*.keystore
