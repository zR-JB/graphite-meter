# Build context is the repo root (docker build -f container/Dockerfile .). Keep it lean.
.git
**/node_modules
client/dist
client/.e2e-dist
client/.vite
client/test-results
client/bench/results
go/graphite-meter
go/graphite-meter-client
go/graphite-meter-client.exe
go/cover.out
go/*.test
go/dist
go/internal/static/dist
.go-cache
.tools
**/.DS_Store
**/__pycache__
.claude

# Never send local TLS material to the image builder.
**/.dev-certs
**/certs
**/certificates
**/letsencrypt
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.der
**/*.csr
**/*.p12
**/*.pfx
**/*.pkcs8
**/*.jks
**/*.keystore
