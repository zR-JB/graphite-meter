{
  "server": {
    "name": "graphite-meter",
    "host": "speed.example",
    "port": 8765,
    "location": "fra"
  },
  "engineVersion": "0.1.0-test",
  "capabilities": {
    "transfers": [
      {
        "id": "http1-clear",
        "origin": "http://speed.example:8765",
        "transport": "fetch-stream",
        "protocol": "http1",
        "tls": false,
        "routes": {
          "probe": "/probe",
          "download": "/download",
          "upload": "/upload",
          "uploadSession": "/upload/session"
        }
      }
    ],
    "channels": [
      {
        "id": "ws-http1-clear",
        "origin": "http://speed.example:8765",
        "transport": "websocket",
        "protocol": "http1",
        "tls": false,
        "routes": {
          "latency": "/ws/ping",
          "uploadProgress": "/ws/upload"
        }
      }
    ]
  }
}
