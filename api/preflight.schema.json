{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphite-meter/api/preflight.schema.json",
  "title": "Preflight",
  "description": "Logical-server discovery returned by GET /preflight. Connection-specific evidence is returned by GET /probe on the selected target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "engineVersion", "capabilities"],
  "properties": {
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "host", "port"],
      "properties": {
        "name": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "location": { "type": "string" }
      }
    },
    "engineVersion": { "type": "string" },
    "capabilities": {
      "type": "object", "additionalProperties": false, "required": ["targets"],
      "properties": {
        "targets": {
          "type": "object", "additionalProperties": false,
          "required": ["http1", "http2", "http3"],
          "properties": {
            "http1": { "$ref": "#/$defs/nullableTarget" },
            "http2": { "$ref": "#/$defs/nullableTarget" },
            "http3": { "$ref": "#/$defs/nullableTarget" }
          }
        }
      }
    }
  },
  "$defs": {
    "nullableTarget": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/target" }] },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["origin", "routes"],
      "properties": {
        "origin": { "type": "string", "format": "uri" },
        "routes": { "$ref": "#/$defs/routes" }
      }
    },
    "routes": {
      "type": "object", "additionalProperties": false,
      "required": ["probe", "download", "upload", "uploadSession", "websocket", "webtransport"],
      "properties": {
        "probe": { "type": "string" },
        "download": { "type": "string" },
        "upload": { "type": "string" },
        "uploadSession": { "type": "string" },
        "websocket": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/websocket" }] },
        "webtransport": { "type": ["string", "null"] }
      }
    },
    "websocket": {
      "type": "object", "additionalProperties": false,
      "required": ["ping", "uploadProgress"],
      "properties": {
        "ping": { "type": "string" },
        "uploadProgress": { "type": "string" }
      }
    }
  }
}
