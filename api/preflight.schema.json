{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphite-meter/api/preflight.schema.json",
  "title": "Preflight",
  "description": "Logical server discovery with independently selectable throughput and latency endpoints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "engineVersion", "generation", "capabilities"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "maxLength": 256 },
        "location": { "type": "string", "maxLength": 256 }
      }
    },
    "engineVersion": { "type": "string", "maxLength": 256 },
    "generation": { "type": "string", "minLength": 1, "maxLength": 256 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["throughput", "latency"],
      "properties": {
        "uploadCheckpoint": { "type": "boolean", "description": "Fresh owner-checked receiver windows are available." },
        "throughput": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/throughputEndpoint" } },
        "latency": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/latencyEndpoint" } }
      }
    }
  },
  "$defs": {
    "baseUrl": { "type": "string", "maxLength": 2048, "pattern": "^(\\.|https?://[^/@?#\\\\\\s]+)$" },
    "throughputEndpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["baseUrl", "transport", "protocol"],
      "properties": {
        "baseUrl": { "$ref": "#/$defs/baseUrl" },
        "transport": { "enum": ["fetch-stream", "webtransport", "webtransport-datagram"] },
        "protocol": { "enum": ["http1", "http2", "http3", "negotiated"] }
      }
    },
    "latencyEndpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["baseUrl", "transport"],
      "properties": {
        "baseUrl": { "$ref": "#/$defs/baseUrl" },
        "transport": { "enum": ["websocket", "webtransport"] }
      }
    }
  }
}
