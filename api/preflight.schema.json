{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphite-meter/api/preflight.schema.json",
  "title": "Preflight",
  "description": "Logical-server discovery returned by GET /preflight. Bulk transfer targets and interactive message channels are independently selectable; connection evidence comes from GET /probe on the selected transfer target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "engineVersion", "capabilities"],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "port"],
      "properties": {
        "name": { "type": "string" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "location": { "type": "string" }
      }
    },
    "engineVersion": { "type": "string" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transfers", "channels"],
      "properties": {
        "transfers": { "type": "array", "items": { "$ref": "#/$defs/transferTarget" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channelTarget" } }
      }
    }
  },
  "$defs": {
    "transferTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "transport", "protocol", "tls", "routes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "format": "uri" },
        "transport": { "enum": ["fetch-stream"] },
        "protocol": { "enum": ["http1", "http2", "http3"] },
        "tls": { "type": "boolean" },
        "routes": { "$ref": "#/$defs/transferRoutes" }
      }
    },
    "transferRoutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "download", "upload", "uploadSession"],
      "properties": {
        "probe": { "type": "string" },
        "download": { "type": "string" },
        "upload": { "type": "string" },
        "uploadSession": { "type": "string" }
      }
    },
    "channelTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "transport", "protocol", "tls", "routes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "format": "uri" },
        "transport": { "enum": ["websocket", "webtransport"] },
        "protocol": { "enum": ["http1", "http2", "http3"] },
        "tls": { "type": "boolean" },
        "routes": { "$ref": "#/$defs/channelRoutes" }
      }
    },
    "channelRoutes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency", "uploadProgress"],
      "properties": {
        "latency": { "type": ["string", "null"] },
        "uploadProgress": { "type": ["string", "null"] }
      }
    }
  }
}
