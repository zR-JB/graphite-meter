{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphite-meter/api/probe.schema.json",
  "title": "Probe",
  "description": "Connection-specific evidence returned by GET /probe on a selected target.",
  "type": "object",
  "additionalProperties": false,
  "required": ["engineVersion", "apiVersion", "clientIp", "clientIpVersion", "clientIpSource", "protocolNegotiated"],
  "properties": {
    "engineVersion": { "type": "string", "maxLength": 256, "description": "The envelope: the server's release; servers up to 0.13.5 send none." },
    "apiVersion": { "type": "integer", "minimum": 1, "description": "The envelope: the API version (apiversions.txt); servers up to 0.13.5 send none." },
    "clientIp": { "type": "string", "minLength": 1, "maxLength": 64 },
    "clientIpVersion": { "type": "integer", "enum": [4, 6] },
    "clientIpSource": { "type": "string", "enum": ["socket", "forwarded"] },
    "protocolNegotiated": { "type": "string", "enum": ["http/1.1", "h2", "h3"] },
    "load": {
      "description": "Measurements the server holds at probe time (active) and its GM_MAX_ACTIVE_MEASUREMENTS (max).",
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "max"],
      "properties": {
        "active": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
