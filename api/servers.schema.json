{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphite-meter/api/servers.schema.json",
  "title": "ServerCatalog",
  "description": "The originating operator's bounded server catalogue. The first entry is synthesized self. IDs and canonical origins are unique; every defaultSelection ID must exist. Runtime validation also enforces UTF-8 byte limits and canonical HTTP(S) origins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultSelection", "servers"],
  "properties": {
    "defaultSelection": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" } },
    "servers": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/serverEntry" } }
  },
  "$defs": {
    "serverEntry": {
      "title": "ServerEntry",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
        "url": { "type": "string", "maxLength": 2048, "pattern": "^(\\.|https?://[^/@?#\\\\\\s*;]+/?)$" },
        "name": { "type": "string", "maxLength": 256 },
        "location": { "type": "string", "maxLength": 256 },
        "additionalOrigins": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^/@?#\\\\\\s*;]+/?$" } }
      }
    }
  }
}
